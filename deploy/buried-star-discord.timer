[Unit]
Description=Read Discord every half hour

[Timer]
# On the clock, not relative to boot. A timer defined only by OnBootSec and
# OnUnitActiveSec has nothing to anchor to when it is enabled days after the
# machine started and has never been triggered: systemd computes no next
# elapse at all, reports "n/a", and simply never runs. That happened here.
#
# OnCalendar always has a next point, and Persistent catches up on one missed
# run after downtime rather than pretending it never happened.
OnCalendar=*:00/30
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
